# Дефолты для dev-сборки. В прод-сборку значения не попадают (см. define.config.mjs).
# Ключ сервисного аккаунта Yandex AI Studio (роль ai.languageModels.user)
YANDEX_API_KEY=
# Идентификатор каталога — подставляется в имя модели gpt://<folder>/yandexgpt/latest
YANDEX_FOLDER_ID=
# Ключ Яндекс.Словаря (dictionary.yandex.net) — бесплатный, 10 000 запросов в сутки.
# Единственный ключ, который попадает и в прод-сборку: с ним перевод слов работает
# сразу после установки. Квота общая на всех, свой ключ читатель ставит в настройках.
YANDEX_DICT_KEY=
