{
  "description": "Сложные слова любой страницы с переводом: подсветка, словарь и тренировка",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.3",
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.32.0",
    "@primevue/auto-import-resolver": "^5.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.1.0",
    "@types/sql.js": "^1.4.11",
    "@types/webextension-polyfill": "^0.12.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.5.18",
    "@vueuse/core": "^13.5.0",
    "chalk": "^5.4.1",
    "chrome-types": "^0.1.365",
    "commander": "^14.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.3.0",
    "get-installed-browsers": "^0.1.7",
    "globals": "^16.3.0",
    "marked": "^16.1.1",
    "pinia": "^3.0.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "terser": "^5.43.1",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-imagemin": "^0.6.9",
    "unplugin-turbo-console": "^2.2.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-router": "^0.14.0",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vite-plugin-zip-pack": "^1.2.4",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.0.4",
    "web-ext": "^8.9.0",
    "webext-bridge": "^6.0.1",
    "webextension-polyfill": "^0.12.0"
  },
  "displayName": "Erudit",
  "license": "GPL-3.0-or-later",
  "name": "erudit",
  "overrides": {
    "@crxjs/vite-plugin": "$@crxjs/vite-plugin"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Hakoba/erudit"
  },
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "cross-env NODE_ENV=production vite build -c vite.chrome.config.ts",
    "build:firefox": "cross-env NODE_ENV=production vite build -c vite.firefox.config.ts",
    "dev": "concurrently \"npm run dev:chrome\" \"npm run dev:firefox\"",
    "dev:chrome": "cross-env NODE_ENV=development vite -c vite.chrome.config.ts",
    "dev:firefox": "cross-env NODE_ENV=development vite build --mode development --watch -c vite.firefox.config.ts",
    "format": "prettier --write .",
    "launch": "tsx scripts/launch.ts",
    "launch:all": "tsx scripts/launch.ts --all",
    "lint": "eslint . --fix --cache",
    "lint:manifest": "web-ext lint --pretty",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "vue-tsc --noEmit",
    "version": "node scripts/release.mjs && git add CHANGELOG.md"
  },
  "type": "module",
  "version": "0.0.3",
  "dependencies": {
    "@primeuix/themes": "^2.0.2",
    "fflate": "^0.8.3",
    "lucide-vue-next": "^0.527.0",
    "primevue": "^4.5.3",
    "sql.js": "^1.14.1",
    "vue-i18n": "^11.4.8"
  }
}
